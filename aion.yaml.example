# Example `aion.yaml`. Every key below is one the SDK reads: unknown keys are
# rejected by name when `aion serve` starts, so this file and the configuration
# model describe the same thing.
#
# Reference: https://docs.aion.to/sdk/python/configuration/aion-yaml

aion:
  # Required. One entry per agent. The key is the agent id, and it is what the
  # server's paths are built from: `/agents/<agent_id>/...`.
  agents:
    support:
      # Required. Import target for agent discovery, `module_or_file[:symbol]`.
      # A LangGraph graph or a factory returning one, an ADK agent or a factory
      # returning one - the adapter is chosen from what the target is.
      path: "./agents/support.py:build_graph"

      # Optional. Shown on the agent card.
      name: "Support Agent"
      description: "Answers product questions and escalates what it cannot."
      version: "1.2.0"

      # Optional. Defaults to ["text"] for both.
      input_modes: ["text"]
      output_modes: ["text"]

      # Optional. Skill metadata, surfaced on the agent card.
      skills:
        - id: "answer-question"
          name: "Answer a product question"
          description: "Replies from the product documentation."
          tags: ["support"]
          examples: ["How do I rotate an API key?"]

      # Optional. Typed configuration fields, exposed through
      # `/.well-known/configuration.json` and filled in by the control plane.
      configuration:
        model:
          type: "llm"
          default: "openai/gpt-4.1-mini"
          required: true
        max_retries:
          type: "integer"
          default: 3
          min: 0
          max: 10
        api_token:
          type: "secret"
          required: true

      # Optional. A2A extensions this agent additionally activates. Extensions
      # that are active by default - distribution, messaging - are not listed
      # here.
      enabled_extensions:
        - "https://docs.aion.to/a2a/extensions/aion/daemon/1.0.0"

    # A second agent is a second entry. Only `path` is required.
    onboarding:
      path: "./agents/onboarding.py:create_agent"

  # Optional. Mounts a proxy at `/mcp` forwarding to an MCP server running on
  # this port. Without this section, no proxy is mounted.
  mcp:
    port: 9000
