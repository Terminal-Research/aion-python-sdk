# These variables are expected in the project which uses this library.

# (Optional) Postgres Configuration
# By default, an in-memory data store will be used.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres

# (Optional) Encryption of sensitive data at rest
# Applies to persisted data such as push-notification configs, which carry
# webhook credentials. Unset means those are stored in plaintext.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Aion API Configuration
# Required for authentication with Aion API services
AION_CLIENT_ID=
AION_CLIENT_SECRET=
AION_API_HOST=https://api.aion.to
AION_API_KEEP_ALIVE=60
